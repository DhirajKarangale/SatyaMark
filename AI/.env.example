# ==========================================
# SatyaMark AI Worker - Environment Variables
# ==========================================

# --- Retry & Backoff Configuration ---
# Controls how Python workers retry failed API calls
EXPONENTIAL_BACKOFF_MAX_RETRIES=3
EXPONENTIAL_BACKOFF_BASE_TIME=2

# --- Redis Polling Rates ---
# How often (in ms) workers check for new jobs
REDIS_RENDER_CHECK_RATE=1000
REDIS_UPSTASH_CHECK_RATE=120000

# --- Redis Connection URIs (Text) ---
REDIS_RENDER_TEXT_URL=
REDIS_UPSTASH_TEXT_URL=

# --- Redis Connection URIs (Image) ---
REDIS_RENDER_IMAGE_URL=
REDIS_UPSTASH_IMAGE_URL=

# --- Search & Scraping APIs ---
# Used by LangGraph for live web verification
SERPER_API_KEYS="
"

# --- Language Models (LLMs) ---
HF_TOKENS="
"
ANTHROPIC_API_KEY="
"

# --- Image Forensics APIs ---
# Deepfake detection, C2PA, and multi-modal scanning
SIGHTENGINE_API_USERS="
"

SIGHTENGINE_API_SECRET="
"

TRUTHSCAN_API_KEY="
"
