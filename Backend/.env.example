# ==========================================
# SatyaMark Backend - Environment Variables
# ==========================================

# --- Orchestrator Settings ---
# The port the Node.js WebSocket & HTTP server will listen on
PORT=2402
# Maximum number of jobs to enqueue per batch
JOB_ENQUEUE_RATE=500
# Threshold (in ms) to trigger job transfer between saturated Redis clusters
REDIS_RENDER_UPSTASH_TRANSFER_RATE=120000

# --- Distributed Redis Queues (Text Verification) ---
# Primary and fallback queues for routing text claims
REDIS_RENDER_TEXT_URL=
REDIS_UPSTASH_TEXT_URL=

# --- Distributed Redis Queues (Image Forensics) ---
# Primary and fallback queues for routing image analysis jobs
REDIS_RENDER_IMAGE_URL=
REDIS_UPSTASH_IMAGE_URL=

# --- Webhook Receivers ---
# Endpoints where the AI workers will HTTP POST the final verdicts
RESULT_RECEIVER_TEXT=http://localhost:2402/ai-callback/text
RESULT_RECEIVER_IMG=http://localhost:2402/ai-callback/image

# --- Database Connection (PostgreSQL) ---
# Used for job deduplication and caching results
DB_HOST=''
DB_NAME='neondb'
DB_PASSWORD=''
DB_USER='neondb_owner'
DB_PORT=5432
DB_SSL=true

# --- Observability ---
# Generates JSON trace timelines for every verified claim
ENABLE_TRACE=true
