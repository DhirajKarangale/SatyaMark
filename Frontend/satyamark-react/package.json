{
  "name": "satyamark-react",
  "version": "0.0.20",
  "description": "React SDK for SatyaMark. Embed real-time AI content verification, deepfake detection, fact-checking, and trust signals directly into your React applications.",
  "license": "MIT",
  "author": "Dhiraj Karangale",
  "homepage": "https://satyamark.js.org/",
  "repository": {
    "type": "git",
    "url": "https://github.com/DhirajKarangale/SatyaMark.git"
  },
  "bugs": {
    "url": "https://github.com/DhirajKarangale/SatyaMark/issues"
  },
  "keywords": [
    "react",
    "content-verification",
    "fact-checking",
    "deepfake-detection",
    "ai-detection",
    "misinformation",
    "fake-news",
    "trust-signals",
    "react-sdk",
    "ui-component",
    "websocket",
    "satyamark"
  ],
  "main": "dist/index.cjs.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs.js",
      "types": "./dist/index.d.ts"
    }
  },
  "sideEffects": false,
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsup",
    "build2": "tsup src/index.ts --format esm,cjs --dts",
    "prepare": "npm run clean && npm run build"
  },
  "peerDependencies": {
    "react": ">=16.8"
  },
  "devDependencies": {
    "rimraf": "^5.0.0",
    "tsup": "^6.7.0",
    "typescript": "^5.0.0"
  }
}